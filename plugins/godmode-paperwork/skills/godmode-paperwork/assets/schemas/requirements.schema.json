{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cubetribe/CODEX_GodMode_ON/schemas/godmode-paperwork/requirements-v1",
  "title": "GodMode Paperwork requirements contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required_documents", "required_claims", "rules"],
  "properties": {
    "schema": {"const": "godmode.paperwork.requirements/v1"},
    "required_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "claim"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "required_claim"},
              "claim": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "minProperties": 3,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "required_document"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "media_type": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "left", "right"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "equals"},
              "left": {"type": "string", "minLength": 1},
              "right": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "terms", "total", "tolerance"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "decimal_sum"},
              "terms": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "minLength": 1}},
              "total": {"type": "string", "minLength": 1},
              "tolerance": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "before", "after"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "date_order"},
              "before": {"type": "string", "minLength": 1},
              "after": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "claim", "format"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "format"},
              "claim": {"type": "string", "minLength": 1},
              "format": {"enum": ["iso-date", "integer", "decimal", "currency", "iban"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "claims"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "unique"},
              "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        ]
      }
    }
  }
}
