{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cubetribe/CODEX_GodMode_ON/schemas/godmode-paperwork/case-v1",
  "title": "GodMode Paperwork case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "assurance", "languages", "created_at", "tool_version", "audit_genesis_sha256", "audit_head_sha256", "audit_count"],
  "properties": {
    "schema": {"const": "godmode.paperwork.case/v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "assurance": {"enum": ["INVENTORY", "EXTRACTION", "CASEWORK"]},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}},
    "created_at": {"type": "string"},
    "tool_version": {"type": "string"},
    "audit_genesis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_head_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_count": {"type": "integer", "minimum": 1}
  }
}
