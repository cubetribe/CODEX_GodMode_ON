{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cubetribe/CODEX_GodMode_ON/schemas/godmode-paperwork/document-v1",
  "title": "GodMode Paperwork document record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sha256", "bytes", "media_type", "original", "source_names", "processable", "support_status"],
  "properties": {
    "schema": {"const": "godmode.paperwork.document/v1"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string"},
    "original": {"type": "string", "pattern": "^originals/[0-9a-f]{2}/[0-9a-f]{64}$"},
    "source_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^/\\\\]+$"}},
    "processable": {"type": "boolean"},
    "support_status": {"enum": ["SUPPORTED", "INVENTORY_ONLY"]},
    "pages_expected": {"type": ["integer", "null"], "minimum": 1}
  }
}
